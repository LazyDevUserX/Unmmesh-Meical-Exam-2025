---
layout: null
---
[
  {% assign first = true %}
  {% for file in site.static_files %}
    {% if file.path contains '/_exams/' and file.path contains 'metadata.json' %}
      {% unless first %},{% endunless %}
      {
        "id": "{{ file.path | remove_first: '/_exams/' | remove: '/metadata.json' }}"
      }
      {% assign first = false %}
    {% endif %}
  {% endfor %}
]
